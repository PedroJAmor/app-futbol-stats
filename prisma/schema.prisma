generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  SUPERADMIN
}

enum LegacyRole {
  ADMIN
  ANOTADOR
  JUGADOR
  VIEWER
}

enum MatchCategory {
  LEAGUE
  MIDWEEK
  SPECIAL
}

enum MatchResult {
  WIN
  LOSS
  DRAW
}

enum TeamSide {
  A
  B
}

enum ForumMentionTarget {
  MATCH
  PLAYER
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(USER)
  playerId      Int?      @unique
  player        Player?   @relation(fields: [playerId], references: [id], onDelete: SetNull)
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model LegacyCredentialUser {
  id           Int        @id @default(autoincrement())
  username     String     @unique
  passwordHash String
  role         LegacyRole @default(VIEWER)
  createdAt    DateTime   @default(now())
}

model Player {
  id             Int                  @id @default(autoincrement())
  firstName      String
  lastName       String?
  nickname       String?
  legacyFullName String?
  photoUrl       String?
  birthDate      DateTime?
  isActive       Boolean              @default(true)
  isHidden       Boolean              @default(false)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  participations MatchParticipation[]
  linkedUser     User?
  mvpMatches     Match[]              @relation("MatchMvp")

  @@index([isHidden, isActive])
  @@index([firstName, lastName])
}

model Venue {
  id             Int      @id @default(autoincrement())
  name           String
  normalizedName String   @unique
  address        String?
  mapUrl         String?
  photoUrl       String?
  courts         Court[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  matches        Match[]

  @@index([name])
}

model Court {
  id             Int      @id @default(autoincrement())
  venueId        Int
  venue          Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  name           String
  normalizedName String
  format         Int?
  photoUrl       String?
  goals          Goal[]
  matches        Match[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([venueId, normalizedName])
}

model Goal {
  id       Int         @id @default(autoincrement())
  courtId  Int
  court    Court       @relation(fields: [courtId], references: [id], onDelete: Cascade)
  position Int
  name     String
  teams    MatchTeam[]

  @@unique([courtId, position])
}

model Match {
  id             Int                  @id @default(autoincrement())
  playedAt       DateTime
  format         Int
  category       MatchCategory?
  courtId        Int?
  court          Court?               @relation(fields: [courtId], references: [id], onDelete: SetNull)
  locationIsDemo Boolean              @default(false)
  venueId        Int?
  venue          Venue?               @relation(fields: [venueId], references: [id], onDelete: SetNull)
  priceCents     Int?
  weather        String?
  temperature    Decimal?             @db.Decimal(5, 2)
  notes          String?
  mvpId          Int?
  mvp            Player?              @relation("MatchMvp", fields: [mvpId], references: [id], onDelete: SetNull)
  isHidden       Boolean              @default(false)
  hiddenAt       DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  teams          MatchTeam[]
  participations MatchParticipation[]
  mentions       ForumMention[]

  @@index([isHidden, playedAt(sort: Desc)])
  @@index([mvpId])
  @@index([venueId])
  @@index([courtId, playedAt])
  @@index([category, playedAt])
}

model MatchTeam {
  id             Int                  @id @default(autoincrement())
  matchId        Int
  match          Match                @relation(fields: [matchId], references: [id], onDelete: Cascade)
  side           TeamSide
  color          String
  result         MatchResult
  defendedGoalId Int?
  defendedGoal   Goal?                @relation(fields: [defendedGoalId], references: [id], onDelete: SetNull)
  participations MatchParticipation[]

  @@index([defendedGoalId])
  @@unique([matchId, side])
  @@index([matchId])
}

model MatchParticipation {
  id       Int       @id @default(autoincrement())
  matchId  Int
  match    Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  teamId   Int
  team     MatchTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  playerId Int
  player   Player    @relation(fields: [playerId], references: [id])
  goals    Int?
  ownGoals Int?

  @@unique([matchId, playerId])
  @@unique([teamId, playerId])
  @@index([playerId, matchId])
  @@index([teamId])
}

model ForumPost {
  id        String         @id @default(cuid())
  text      String
  parentId  String?
  parent    ForumPost?     @relation("ForumReplies", fields: [parentId], references: [id], onDelete: Restrict)
  replies   ForumPost[]    @relation("ForumReplies")
  isHidden  Boolean        @default(false)
  deletedAt DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  mentions  ForumMention[]

  @@index([parentId, createdAt])
  @@index([isHidden, createdAt(sort: Desc)])
}

model ForumMention {
  id            String             @id @default(cuid())
  postId        String
  post          ForumPost          @relation(fields: [postId], references: [id], onDelete: Cascade)
  targetType    ForumMentionTarget
  matchId       Int?
  match         Match?             @relation(fields: [matchId], references: [id], onDelete: SetNull)
  playerId      Int?
  token         String             @unique
  labelSnapshot String
  createdAt     DateTime           @default(now())

  @@index([postId])
  @@index([matchId])
}

model AnonymousRateLimit {
  id              String   @id @default(cuid())
  fingerprintHash String
  bucketStart     DateTime
  count           Int      @default(1)
  expiresAt       DateTime

  @@unique([fingerprintHash, bucketStart])
  @@index([expiresAt])
}
