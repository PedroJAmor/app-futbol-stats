# Base de datos Neon staging. Nunca apuntar estos comandos a producción.
DATABASE_URL="postgresql://user:password@staging-host/dbname?sslmode=require"
EXPECTED_DATABASE_HOST="staging-host"
DATABASE_SAFETY_TAG="rebuild-v2/staging"
# Solo para prisma migrate dev contra una base descartable.
SHADOW_DATABASE_URL="postgresql://user:password@discardable-shadow-host/dbname?sslmode=require"

# NextAuth v4 + Google OAuth
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
SUPERADMIN_EMAILS="admin@example.com"

# Límites compartidos en PostgreSQL: HMAC temporal sin identidad en publicaciones.
ANONYMOUS_RATE_LIMIT_SECRET=""
ANONYMOUS_RATE_LIMIT_MAX="5"
ANONYMOUS_RATE_LIMIT_WINDOW_MS="600000"
# Techo adicional por IP (IPv6 /64), con margen para Wi-Fi compartida.
ANONYMOUS_RATE_LIMIT_NETWORK_MAX="50"
# Consultas públicas HTTP por minuto y red; no incluye páginas SSR.
PUBLIC_API_RATE_LIMIT_MAX="120"
# Fotos por cuenta administrativa cada 10 minutos.
UPLOAD_RATE_LIMIT_MAX="10"

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
