# ──────────────────────────────────────────────────────────
# Copiar este archivo a .env y completar con tus valores
# El .env NUNCA se sube a git (ya está en .gitignore)
# ──────────────────────────────────────────────────────────

# BASE DE DATOS — Neon PostgreSQL
# 1. Crear cuenta en https://neon.tech (gratis)
# 2. New Project → darle un nombre
# 3. Copiar la "Connection string" que aparece en el dashboard
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# NEXTAUTH
# NEXTAUTH_SECRET: generarlo con este comando en la terminal:
#   openssl rand -base64 32
# NEXTAUTH_URL: en producción cambiar por la URL de Vercel
NEXTAUTH_SECRET="reemplazar-con-string-aleatorio-generado"
NEXTAUTH_URL="http://localhost:3000"

# CONTRASEÑA DEL ADMIN INICIAL
# Se usa solo al correr: npm run db:seed
# Después de hacer el seed, esta variable ya no es necesaria
ADMIN_PASSWORD="cambiar-por-una-contraseña-segura"

# CLOUDINARY — para fotos de jugadores
# 1. Crear cuenta en https://cloudinary.com (gratis)
# 2. Dashboard → copiar Cloud Name, API Key y API Secret
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="tu-cloud-name"
CLOUDINARY_API_KEY="tu-api-key"
CLOUDINARY_API_SECRET="tu-api-secret"
