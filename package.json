{
  "name": "futbol-amigos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:visual": "node --env-file=.env --import tsx scripts/visual-dev.ts",
    "preview:visual": "node --env-file=.env --import tsx scripts/visual-dev.ts --production",
    "build": "prisma generate && next build",
    "start": "next start -p 3000",
    "db:studio": "prisma studio",
    "db:guard": "tsx --env-file=.env prisma/migration-scripts/guard-env.ts",
    "db:export:v1": "tsx --env-file=.env prisma/migration-scripts/export-v1.ts",
    "db:preflight:v1": "tsx --env-file=.env prisma/migration-scripts/preflight-v1.ts",
    "db:migrate:baseline": "tsx --env-file=.env prisma/migration-scripts/resolve-baseline.ts",
    "db:migrate:staging": "tsx --env-file=.env prisma/migration-scripts/migrate-v1-to-v2.ts",
    "db:validate:v2": "tsx --env-file=.env prisma/migration-scripts/validate-v2.ts",
    "db:normalize:players": "tsx --env-file=.env prisma/migration-scripts/normalize-player-names.ts",
    "db:normalize:players:apply": "tsx --env-file=.env prisma/migration-scripts/normalize-player-names.ts --apply",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^5.10.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "next": "^14.2.0",
    "next-auth": "^4.24.7",
    "react": "^18",
    "react-dom": "^18",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "jsdom": "^26.1.0",
    "prisma": "^5.10.0",
    "tsx": "^4.7.0",
    "typescript": "^5",
    "vitest": "^2.1.0"
  }
}
